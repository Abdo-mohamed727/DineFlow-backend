# Server
PORT=3000
NODE_ENV=development

# MongoDB (local fallback provided; MongoDB Atlas recommended for cloud)
# Local example:  mongodb://127.0.0.1:27017/dineflow
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dineflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dineflow

# JWT
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# CORS (comma separated; use * to allow all - NOT recommended for prod)
CORS_ORIGIN=*

# Cloudinary (image uploads). Optional in dev - if missing, uploads are skipped and a placeholder URL is stored.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Order tax rate applied on subtotal (e.g. 0.14 = 14% VAT in Egypt)
TAX_RATE=0.14

# Upload limits
MAX_UPLOAD_MB=5
